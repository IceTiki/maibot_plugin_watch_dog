{
  "manifest_version": 2,
  "id": "local.watch-dog",
  "version": "0.5.0",
  "name": "Watch Dog",
  "description": "按顺序匹配的消息过滤、上下文追加与互动跟进窗口",
  "author": {
    "name": "Tiki",
    "url": "https://github.com/IceTiki"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/IceTiki/maibot_plugin_watch_dog"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "9.99.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "capabilities": [
    "send.text",
    "chat.open_session",
    "maisaka.context.append",
    "message.get_by_id",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "i18n",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
